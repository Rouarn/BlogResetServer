# ==============================================
# 生产环境配置文件      请根据实际情况修改以下配置
# ==============================================

# 环境标识
NEST_USER_NODE_ENV=production

# 服务器配置
NEST_PORT=3000

# 生产环境JWT密钥 (需要更强的密钥)
NEST_JWT_SECRET=your-super-strong-production-secret-key-change-this

# 数据库配置 (生产环境)
NEST_DATABASE_HOST=your-production-db-host
NEST_DATABASE_PORT=3306
NEST_DATABASE_USER=your-production-db-user
NEST_DATABASE_PASSWORD=your-production-db-password
NEST_DATABASE_NAME=your-production-db-name

# 生产环境特定设置
NEST_DATABASE_LOGGING=false
NEST_DATABASE_SYNCHRONIZE=false
NEST_STATIC_ASSETS_MAXAGE=86400

# 生产环境CORS设置 (严格)
NEST_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# 生产环境安全设置
NEST_ENABLE_DEBUG=false
NEST_LOG_LEVEL=error

# 文件上传配置（生产环境）
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# API 版本控制配置
# API 前缀，默认为 'api'
API_PREFIX=api

# 默认 API 版本，默认为 '1'
API_DEFAULT_VERSION=1

# 示例：
# 如果设置 API_PREFIX=service，API_DEFAULT_VERSION=2
# 则 API 路径将变为 /service/v2/...
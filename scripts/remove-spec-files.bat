@echo off
REM =============================================================================
REM NestJS 测试文件清理脚本 (Windows 批处理版本)
REM 
REM 功能说明：
REM - 递归搜索项目中的所有 .spec.ts 测试文件
REM - 提供交互式确认，防止误删除
REM - 显示详细的删除进度和结果统计
REM - 包含错误处理和用户友好的提示信息
REM 
REM 使用场景：
REM - Windows 环境下的测试文件清理
REM - 生产环境部署前的文件清理
REM - 批量删除不需要的测试代码
REM - 项目重构时的文件整理
REM 
REM 使用方法：
REM - 双击运行：remove-spec-files.bat
REM - 命令行运行：scripts
emove-spec-files.bat
REM - 在项目根目录执行：scripts
emove-spec-files.bat
REM 
REM 注意事项：
REM - 此操作不可逆，请确保已备份重要文件
REM - 会搜索整个项目目录（包括子目录）
REM - 删除前会显示所有找到的文件并要求确认
REM =============================================================================

REM 关闭命令回显，使输出更清洁
@echo off

REM 启用延迟变量扩展，支持在循环中修改变量
setlocal enabledelayedexpansion

REM 显示脚本标题和说明
echo ===============================================
echo  NestJS 测试文件清理工具 (Windows 批处理版)
echo ===============================================
echo.
echo 🔍 开始搜索并删除所有 .spec.ts 文件...
echo.

REM 初始化计数器变量
set "count=0"      REM 找到的文件总数
set "deleted=0"    REM 成功删除的文件数

REM -----------------------------------------------------------------------------
REM 第一阶段：搜索并列出所有 .spec.ts 文件
REM 使用 for /r 命令递归搜索指定目录及其子目录
REM %~dp0.. 表示脚本所在目录的上级目录（项目根目录）
REM -----------------------------------------------------------------------------
echo 📁 搜索范围: %~dp0..
echo.

for /r "%~dp0.." %%f in (*.spec.ts) do (
    set /a count+=1
    echo 找到: %%f
)

REM 检查是否找到任何文件
if !count! equ 0 (
    echo ⚠️  未找到任何 .spec.ts 文件
    echo.
    echo 💡 可能的原因：
    echo    - 项目中没有测试文件
    echo    - 测试文件使用了不同的命名规则
    echo    - 脚本不在正确的目录中执行
    pause
    exit /b 0
)

REM -----------------------------------------------------------------------------
REM 第二阶段：用户确认
REM 显示找到的文件数量并要求用户确认删除操作
REM -----------------------------------------------------------------------------
echo.
echo 📊 统计结果: 找到 !count! 个 .spec.ts 文件
echo.
echo ⚠️  警告: 此操作不可逆！
echo 💡 建议: 删除前请确保已提交代码到版本控制系统
echo.
set /p confirm="❓ 确认删除这些文件吗？(y/N): "

REM 检查用户输入，如果不是 'y' 或 'Y' 则取消操作
if /i "!confirm!" neq "y" (
    echo.
    echo ❌ 操作已取消
    echo 💡 如需删除，请重新运行脚本并输入 'y' 确认
    pause
    exit /b 0
)

REM -----------------------------------------------------------------------------
REM 第三阶段：执行删除操作
REM 遍历所有找到的文件并逐个删除
REM -----------------------------------------------------------------------------
echo.
echo 🗑️  开始删除文件...
echo.

for /r "%~dp0.." %%f in (*.spec.ts) do (
    REM 尝试删除文件，2>nul 表示隐藏错误输出
    del "%%f" 2>nul
    
    REM 检查文件是否成功删除
    if not exist "%%f" (
        echo ✅ 已删除: %%f
        set /a deleted+=1
    ) else (
        echo ❌ 删除失败: %%f
    )
)

REM -----------------------------------------------------------------------------
REM 第四阶段：显示结果统计
REM 显示删除操作的最终结果和统计信息
REM -----------------------------------------------------------------------------
echo.
echo ===============================================
echo 🎉 删除操作完成！
echo.
echo 📊 操作统计:
echo    找到文件: !count! 个
echo    成功删除: !deleted! 个
echo    删除失败: !count! - !deleted! = !count! - !deleted! 个

REM 计算失败数量
set /a failed=!count! - !deleted!
if !failed! gtr 0 (
    echo.
    echo ⚠️  部分文件删除失败，可能的原因：
    echo    - 文件被其他程序占用
    echo    - 权限不足
    echo    - 文件为只读属性
)

echo.
echo 💡 提示:
echo    - 如需恢复文件，请从版本控制系统还原
echo    - 如需重新生成测试文件，可使用 NestJS CLI
echo    - 建议运行 npm test 验证项目是否正常

REM 等待用户按键后退出
pause
# ===========================================
# 环境变量配置示例
# ===========================================
# 复制此文件为 .env.development 或 .env.production 并填入实际值

# 环境标识 (development | production | test)
NEST_USER_NODE_ENV=development

# 服务器配置
NEST_PORT=8848

# JWT配置 (必须配置)
NEST_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-environment

# 数据库配置
NEST_DATABASE_HOST=localhost
NEST_DATABASE_PORT=3306
NEST_DATABASE_USER=your-db-user
NEST_DATABASE_PASSWORD=your-db-password
NEST_DATABASE_NAME=your-db-name

# 数据库选项
NEST_DATABASE_LOGGING=false
NEST_DATABASE_SYNCHRONIZE=true

# Redis 配置
# Redis 开关控制 (默认关闭)
NEST_REDIS_ENABLED=false
NEST_REDIS_HOST=localhost
NEST_REDIS_PORT=6379
NEST_REDIS_PASSWORD=
NEST_REDIS_DB=0

# 文件上传配置
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# 静态资源配置
NEST_STATIC_ASSETS_MAXAGE=86400

# CORS配置
NEST_CORS_ORIGINS=http://localhost:3000,http://localhost:9527

# 功能开关
NEST_ENABLE_DEBUG=true
NEST_LOG_LEVEL=debug
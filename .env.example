# ============================================================
# Blog Reset Server 环境变量示例
#
# 复制为 .env 后按需修改；不要提交真实密钥。每条都标注了：用途 / 是否必填 / 默认值 / 格式示例 / 取值来源。
# 加载顺序：先读 .env.{NODE_ENV}，再用 .env 补缺，同名键以先读到者为准（进程环境变量优先级最高）。
# 与默认值的关系：除 NEST_REDIS_PASSWORD 外，写成 `KEY=` 空值会触发启动校验失败，省略整行才走默认值。
# ============================================================

# ---------- 服务基础 ----------

# NODE_ENV：运行环境，决定加载哪个 env 文件并切换多项行为。【可选】默认 development，仅 development | production | test
# 示例：development | production | test
# 取值：本地开发填 development；生产由启动脚本（deploy/start-*.sh、deploy/start-app-BT.js）强制设为 production，不要手改
NODE_ENV=development

# NEST_PORT：HTTP 监听端口。【可选】默认 3000
# 示例：8848
# 取值：自行指定，需与防火墙/反代放行端口一致；部署包 README 以 8848 为例
NEST_PORT=8848

# NEST_BASE_URL：对外访问基址，含协议与端口、不带结尾斜杠。【可选】默认 http://localhost:3000
# 示例：https://api.example.com
# 取值：按真实访问入口填写；上传文件的绝对地址（StorageService.getUrl）和启动日志里的文档链接都由它拼接，填错前端会拿到不可访问的文件 URL
NEST_BASE_URL=http://localhost:3000

# NEST_APP_TITLE：应用名称，用于启动日志与访问页展示。【可选】默认 NestJS Template
# 示例：Blog Reset Server
# 取值：自行指定；运行时自动追加「 - 开发/测试/生产环境」后缀
NEST_APP_TITLE='NestJS Template'

# ---------- 认证与会话 ----------

# NEST_JWT_SECRET：JWT 签名密钥（HS256）。【必填】无默认值
# 示例：9f2c7b1e4a8d5c30b6e7f1a2d4c8b9e0（仅格式示例，勿照抄）
# 取值：自行生成，例如 openssl rand -hex 32；泄露等于登录态可被伪造，更换后所有已签发令牌立即失效
NEST_JWT_SECRET=change_me

# NEST_JWT_ACCESS_TOKEN_TTL：访问令牌有效期（秒）。【可选】默认 3600
# 示例：3600（1 小时）
# 取值：必须写纯数字秒（不能写 7d），且应短于刷新令牌；写非数字会启动校验失败
NEST_JWT_ACCESS_TOKEN_TTL=3600

# NEST_JWT_REFRESH_TOKEN_TTL：刷新令牌有效期（秒）。【可选】默认 604800
# 示例：604800（7 天）
# 取值：同样必须写纯数字秒；越长被盗用后的风险窗口越大，一般 7–30 天
NEST_JWT_REFRESH_TOKEN_TTL=604800

# NEST_BCRYPT_SALT_ROUNDS：bcrypt 加密轮数。【可选】默认 10，允许范围 4–31
# 示例：10
# 取值：10–12 较均衡，越大越慢；越界会启动失败；只影响之后新写入的密码，已有哈希不受影响
NEST_BCRYPT_SALT_ROUNDS=10

# NEST_AUTH_MAX_LOGIN_ATTEMPTS：触发账号锁定的连续失败次数。【可选】默认 5
# 示例：5
# 取值：正整数；失败次数达到即锁定，仅登录成功才清零（锁定到期后累计次数保留，用于指数退避）
NEST_AUTH_MAX_LOGIN_ATTEMPTS=5

# NEST_AUTH_BASE_LOCK_DURATION：首次锁定时长（秒，即 30 分钟）。【可选】默认 1800
# 示例：1800
# 取值：实际锁定时长 = 本值 × 2^(超出最大尝试次数的次数)，直到 NEST_AUTH_MAX_LOCK_DURATION 封顶
NEST_AUTH_BASE_LOCK_DURATION=1800

# NEST_AUTH_MAX_LOCK_DURATION：锁定时长上限（秒，即 24 小时）。【可选】默认 86400
# 示例：86400
# 取值：应大于等于基础锁定时长，指数退避到这里封顶
NEST_AUTH_MAX_LOCK_DURATION=86400

# ---------- API 版本 ----------

# API_PREFIX：所有接口的路径前缀。【可选】默认 api
# 示例：api
# 取值：一般不改；修改后所有路由与前端调用需同步调整
API_PREFIX=api

# API_DEFAULT_VERSION：默认接口版本号（字符串）。【可选】默认 1
# 示例：1
# 取值：与控制器声明的版本对应，同时被拼成 Swagger 文档版本（V1）
API_DEFAULT_VERSION=1

# API_VERSIONING_TYPE：版本传递方式。【可选】默认 header，仅 uri | header
# 示例：header → /api/users + 请求头 X-Api-Version: 1；uri → /api/v1/users
# 取值：与前端约定的方式一致即可，二者只能选一，填其他值会启动失败
API_VERSIONING_TYPE=header

# API_VERSIONING_HEADER：版本请求头名（仅在 type=header 时生效）。【可选】默认 X-Api-Version
# 示例：X-Api-Version
# 取值：需与前端/网关一致；改名而未同步会让请求全部落到默认版本
API_VERSIONING_HEADER=X-Api-Version

# ---------- 接口文档（Swagger） ----------
# 说明：是否开启由 NODE_ENV 决定，production 下强制关闭；以下四项在生产环境填了也不生效。

# NEST_SWAGGER_PREFIX：Swagger UI 访问路径。【可选】默认 /api-docs
# 示例：/api-docs
# 取值：自行指定，需以 / 开头并避开业务路由前缀
NEST_SWAGGER_PREFIX=/api-docs

# NEST_SWAGGER_TITLE：文档标题。【可选】默认 API Documentation
# 示例：Blog Reset Server API
# 取值：自行指定；运行时自动追加「 - 开发版/测试版/生产版」
NEST_SWAGGER_TITLE='NestJS Template API'

# NEST_SWAGGER_DESCRIPTION：文档描述。【可选】默认 API文档
# 示例：博客后端接口文档
# 取值：自行填写，支持任意文本
NEST_SWAGGER_DESCRIPTION='API documentation for NestJS Template'

# NEST_SWAGGER_FILENAME：导出的 JSON 文件名。【可选】默认 api-docs.json
# 示例：api-docs.json
# 取值：只写文件名，写入静态资源根目录后经 {NEST_STATIC_ASSETS_PREFIX}/{文件名} 访问，不要带路径
NEST_SWAGGER_FILENAME=api-docs.json

# ---------- 跨域（CORS） ----------

# NEST_CORS_ORIGINS：允许的跨域来源，逗号分隔，* 表示全部放行。【可选】默认空（等于不放开跨域）
# 示例：http://localhost:3000,https://blog.example.com
# 取值：填前端实际域名（协议+域名+端口，不带结尾斜杠）；生产严格比对完全一致的 Origin，无 Origin 的请求（curl、服务端调用）始终放行；写成空值会启动失败
NEST_CORS_ORIGINS=http://localhost:3000

# ---------- 数据库（MySQL） ----------

# NEST_DATABASE_HOST：MySQL 主机地址。【可选】默认 localhost
# 示例：127.0.0.1
# 取值：与数据库同机部署填 127.0.0.1，分离部署填内网地址
NEST_DATABASE_HOST=127.0.0.1

# NEST_DATABASE_PORT：MySQL 端口。【可选】默认 3306
# 示例：3306
# 取值：按数据库实例实际端口填写
NEST_DATABASE_PORT=3306

# NEST_DATABASE_USER：数据库用户名。【必填】
# 示例：blog_reset_server
# 取值：在宝塔「数据库」或 MySQL 里为本站点单独建库建用户，不要直接用 root
NEST_DATABASE_USER=root

# NEST_DATABASE_PASSWORD：数据库密码。【必填】不能为空字符串
# 示例：S3cure-Random-Passw0rd
# 取值：与上面的用户名成对创建时设置；含特殊符号时建议整体加单引号
NEST_DATABASE_PASSWORD=change_me

# NEST_DATABASE_NAME：数据库名。【必填】需提前建库
# 示例：blog_reset_server
# 取值：数据库里已存在的库名，首次部署请先建库再启动，应用不会自动建库
NEST_DATABASE_NAME=nestjs_template

# NEST_DATABASE_TABLE_PREFIX：所有表名的统一前缀。【可选】默认 ra_
# 示例：ra_
# 取值：建表后不要修改，改前缀等于换一批表名，TypeORM 会找不到已有表
NEST_DATABASE_TABLE_PREFIX=ra_

# NEST_DATABASE_ENABLE_TIMESTAMPS：是否自动维护创建/更新时间。【可选】默认 true
# 示例：true | false
# 取值：true 时插入自动补 createdAt/updatedAt、更新自动刷新 updatedAt；关掉后两列保持 null，需业务代码自行赋值
NEST_DATABASE_ENABLE_TIMESTAMPS=true

# NEST_DATABASE_CREATE_TIME：createdAt 对应的数据库列名。【可选】默认代码兜底为 create_time
# 示例：createTime（本项目 env 统一用驼峰）
# 取值：由命名策略用于生成列名，建表后修改会造成列名不匹配，需配合迁移
NEST_DATABASE_CREATE_TIME=createTime

# NEST_DATABASE_UPDATE_TIME：updatedAt 对应的数据库列名。【可选】默认代码兜底为 update_time
# 示例：updateTime
# 取值：同上，建表后不要随意修改
NEST_DATABASE_UPDATE_TIME=updateTime

# NEST_DATABASE_SYNCHRONIZE：是否按实体自动变更表结构。【可选】默认非 production 下 true
# 示例：false
# 取值：开发期可开启；production 下由代码强制关闭（忽略此值），生产只能手工建表或执行迁移
NEST_DATABASE_SYNCHRONIZE=false

# NEST_DATABASE_LOGGING：是否打印 SQL 日志。【可选】默认 false
# 示例：true | false
# 取值：排查 SQL 问题时临时开启，长期开启日志量很大
NEST_DATABASE_LOGGING=false

# ---------- 静态资源与文件上传 ----------

# NEST_STATIC_ASSETS_DIR：静态资源根目录（相对进程工作目录或绝对路径）。【可选】默认 ./static
# 示例：./static 或 /www/wwwroot/blog-reset-server/static
# 取值：上传文件与导出的 api-docs.json 都放这里，经 NEST_STATIC_ASSETS_PREFIX 对外暴露，一般保持默认
NEST_STATIC_ASSETS_DIR=./static

# NEST_STATIC_ASSETS_PREFIX：静态资源访问前缀。【可选】默认 /static
# 示例：/static
# 取值：以 / 开头；与 NEST_STATIC_UPLOAD_PATH 去掉静态根后的相对部分一起拼成文件访问地址
NEST_STATIC_ASSETS_PREFIX=/static

# NEST_STATIC_ASSETS_MAXAGE：静态资源浏览器缓存时间（秒）。【可选】默认 86400
# 示例：86400（1 天）
# 取值：调大后同 URL 替换文件，客户端可能仍读旧缓存，需配合文件名变化使用
NEST_STATIC_ASSETS_MAXAGE=86400

# NEST_STATIC_UPLOAD_PATH：上传文件实际落盘目录。【可选】默认代码兜底 ./uploads
# 示例：./static/uploads
# 取值：必须位于 NEST_STATIC_ASSETS_DIR 之下，否则 StorageService 按「上传目录 - 静态根」算出的相对路径为空/错误，返回的文件地址不可访问
NEST_STATIC_UPLOAD_PATH=./static/uploads

# NEST_UPLOAD_MAX_SIZE：单个文件大小上限（字节）。【可选】默认 10485760（10MB）
# 示例：10485760
# 取值：同时约束 multer 与业务校验，需与前端限制保持一致，超出直接报错
NEST_UPLOAD_MAX_SIZE=10485760

# NEST_UPLOAD_ALLOWED_TYPES：允许上传的 MIME 类型，逗号分隔，空列表表示不限制。【可选】默认空（不限制）
# 示例：image/jpeg,image/png,image/gif,application/pdf
# 取值：省略整行 = 不限制类型（生产建议显式列出）；写成 KEY= 空值会被启动校验拒绝，要放开全部就删除或注释掉整行
NEST_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# NEST_UPLOAD_MAX_FILES：单次批量上传的文件数上限。【可选】默认 10
# 示例：10
# 取值：正整数，与前端批量上传能力对齐
NEST_UPLOAD_MAX_FILES=10

# ---------- 缓存（Redis） ----------

# NEST_REDIS_ENABLED：是否启用 Redis 缓存。【可选】默认 true
# 示例：true | false
# 取值：生产必须为 true；设为 false 会退化为 NoopCacheService（完全不缓存），登出/改密后的令牌黑名单校验随之失效
NEST_REDIS_ENABLED=true

# NEST_REDIS_HOST：Redis 地址。【可选】默认 localhost
# 示例：127.0.0.1
# 取值：同机部署填 127.0.0.1，否则填实际地址
NEST_REDIS_HOST=127.0.0.1

# NEST_REDIS_PORT：Redis 端口。【可选】默认 6379
# 示例：6379
# 取值：按实例实际端口填写
NEST_REDIS_PORT=6379

# NEST_REDIS_PASSWORD：Redis 密码。【可选】默认空（无密码），本文件里唯一允许写成空值的键
# 示例：留空表示不鉴权
# 取值：与 Redis 的 requirepass 一致；无密码时写成 KEY= 是合法的，不要加引号
NEST_REDIS_PASSWORD=change_me

# NEST_REDIS_DB：使用的库序号（0–15）。【可选】默认 0
# 示例：0
# 取值：多项目共用实例时用不同序号隔离；换库等于换整个键空间，旧缓存与令牌黑名单都不再生效
NEST_REDIS_DB=0

# NEST_REDIS_CONNECT_TIMEOUT：建立连接超时（毫秒）。【可选】默认 10000
# 示例：10000
# 取值：跨机房或网络较差时适当调大
NEST_REDIS_CONNECT_TIMEOUT=10000

# NEST_REDIS_COMMAND_TIMEOUT：单条命令超时（毫秒）。【可选】默认 5000
# 示例：5000
# 取值：过小会在慢查询时误判失败，缓存读写失败按未命中处理
NEST_REDIS_COMMAND_TIMEOUT=5000

# NEST_REDIS_RETRIES：单条命令最大重试次数。【可选】默认 3
# 示例：3
# 取值：对应 ioredis 的 maxRetriesPerRequest；调大可扛抖动，但故障时会拖慢请求
NEST_REDIS_RETRIES=3

# NEST_REDIS_KEEP_ALIVE：TCP keepalive 初始延迟（毫秒）。【可选】默认 30000
# 示例：30000
# 取值：0 表示关闭；长连接经过 NAT/防火墙时保留默认值可探测死连接
NEST_REDIS_KEEP_ALIVE=30000

# NEST_REDIS_ENABLE_READY_CHECK：连接后是否等待 ready 检查。【可选】默认 false
# 示例：false
# 取值：开启后启动时会多做一次探测，主从/集群场景更稳
NEST_REDIS_ENABLE_READY_CHECK=true

# NEST_REDIS_LAZY_CONNECT：是否延迟到首次使用才连接。【可选】默认 true
# 示例：true
# 取值：初始化时代码会显式 connect()，一般保持 true 即可
NEST_REDIS_LAZY_CONNECT=true

# NEST_REDIS_DEFAULT_TTL：缓存默认过期时间（秒）。【可选】默认 3600
# 示例：3600
# 取值：仅在业务没有显式指定 TTL 时生效；令牌黑名单等键用各自的 TTL
NEST_REDIS_DEFAULT_TTL=3600

# NEST_REDIS_KEY_PREFIX：所有缓存键的统一前缀。【可选】默认 nestjs:
# 示例：nestjs:prod:
# 取值：多项目共用实例时用于隔离；改前缀后旧键不会被清理也不会再命中，会一直占内存，模板里的 change_me 是占位需替换
NEST_REDIS_KEY_PREFIX=change_me

# 应用配置
NEST_GLOB_APP_TITLE=我与夏季 Ra
NEST_PORT=8848
NEST_USER_NODE_ENV=development

# JWT配置
NEST_JWT_SECRET=your-jwt-secret-key
NEST_JWT_ACCESS_TOKEN_TTL=1d


# 静态资源配置
NEST_STATIC_ASSETS_PATH=./static
NEST_STATIC_ASSETS_URL=/static
NEST_STATIC_ASSETS_MAXAGE=86400

# Swagger配置
NEST_SWAGGER_TITLE=我与夏季 Ra API
NEST_SWAGGER_DESCRIPTION=我与夏季 Ra 系统API文档
NEST_SWAGGER_VERSION=1.0
NEST_SWAGGER_PREFIX=/api-docs

# 数据库配置
NEST_DATABASE_HOST=localhost
NEST_DATABASE_PORT=3306
NEST_DATABASE_USER=your_username
NEST_DATABASE_PASSWORD=your_password
NEST_DATABASE_NAME=your_database
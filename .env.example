# =============================================================================
# NestJS Template 环境变量配置示例
# =============================================================================
# 此文件是环境变量配置的模板和说明文档
# 使用方法：复制此文件为 .env 并根据实际环境修改配置值
# 注意：生产环境中请使用安全的密钥和密码

# =============================================================================
# 应用基础配置
# =============================================================================
# 应用运行环境
# 说明：此配置决定加载哪个环境配置文件
# - development: 加载 .env.development (开发环境)
# - production: 加载 .env.production (生产环境)
# - 通用配置: .env (所有环境共享的基础配置)
# - 配置模板: .env.example (环境变量配置示例和说明)
NODE_ENV=development

# 应用服务端口
# 开发环境建议使用 8848，生产环境建议使用 3000 或 80/443
NEST_APP_PORT=3000

# 应用名称
NEST_APP_NAME="NestJS Template"

# 应用版本
NEST_APP_VERSION=1.0.0

# 应用描述
NEST_APP_DESCRIPTION="基于 NestJS 的现代化后端 API 系统"

# =============================================================================
# JWT 认证配置
# =============================================================================
# JWT 签名密钥 (生产环境请使用复杂的随机字符串)
NEST_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT 访问令牌过期时间
NEST_JWT_ACCESS_TOKEN_TTL=1d

# JWT 刷新令牌过期时间
NEST_JWT_REFRESH_TOKEN_TTL=7d

# =============================================================================
# 数据库配置 (MySQL)
# =============================================================================
# 数据库主机地址
NEST_DB_HOST=localhost

# 数据库端口
NEST_DB_PORT=3306

# 数据库用户名
NEST_DB_USERNAME=root

# 数据库密码
NEST_DB_PASSWORD=your-database-password

# 数据库名称
NEST_DB_DATABASE=nestjs_template

# 数据库连接池大小
NEST_DB_POOL_SIZE=10

# 数据库连接超时时间 (毫秒)
NEST_DB_TIMEOUT=60000

# 是否启用数据库日志 (true | false)
NEST_DB_LOGGING=false

# 是否自动同步数据库结构 (仅开发环境使用)
NEST_DB_SYNCHRONIZE=false

# =============================================================================
# Redis 缓存配置
# =============================================================================
# 是否启用 Redis 缓存 (true | false)
# 设置为 false 时将使用内存缓存作为 fallback
NEST_REDIS_ENABLED=true

# Redis 服务器地址
NEST_REDIS_HOST=localhost

# Redis 服务器端口
NEST_REDIS_PORT=6379

# Redis 密码 (如果没有密码请留空或删除此行)
NEST_REDIS_PASSWORD=

# Redis 数据库索引 (0-15)
NEST_REDIS_DB=0

# Redis 连接选项
# 是否延迟连接 (true | false)
NEST_REDIS_LAZY_CONNECT=true

# 故障转移重试延迟 (毫秒)
NEST_REDIS_RETRY_DELAY_ON_FAILOVER=100

# 每个请求的最大重试次数
NEST_REDIS_MAX_RETRIES_PER_REQUEST=3

# 缓存配置
# 默认缓存过期时间 (秒)
NEST_REDIS_CACHE_DEFAULT_TTL=3600

# 缓存键前缀
NEST_REDIS_CACHE_KEY_PREFIX=nestjs:

# 内存缓存最大条目数 (当 Redis 不可用时使用)
NEST_REDIS_CACHE_MAX_SIZE=1000

# =============================================================================
# 文件上传配置
# =============================================================================
# 文件上传目录
NEST_UPLOAD_DIR=./uploads

# 单个文件最大大小 (字节)
NEST_MAX_FILE_SIZE=10485760

# 允许的文件类型 (用逗号分隔)
NEST_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# =============================================================================
# 静态资源配置
# =============================================================================
# 静态资源访问路径前缀
NEST_STATIC_PREFIX=/static

# 静态资源目录
NEST_STATIC_DIR=./public

# =============================================================================
# CORS 跨域配置
# =============================================================================
# 允许的源地址 (用逗号分隔，* 表示允许所有)
NEST_CORS_ORIGIN=http://localhost:8080

# 是否允许携带凭证
NEST_CORS_CREDENTIALS=true

# =============================================================================
# Swagger 文档配置
# =============================================================================
# 是否启用 Swagger 文档 (true | false)
NEST_SWAGGER_ENABLED=true

# Swagger 文档访问路径
NEST_SWAGGER_PATH=api-docs

# Swagger 文档标题
NEST_SWAGGER_TITLE="NestJS Template API"

# Swagger 文档描述
NEST_SWAGGER_DESCRIPTION="基于 NestJS 的现代化后端 API 系统文档"

# =============================================================================
# 调试工具配置
# =============================================================================
# 是否启用调试模式 (true | false)
NEST_DEBUG_ENABLED=true

# 是否启用请求追踪 (true | false)
NEST_DEBUG_REQUEST_TRACKING=true

# 是否启用性能监控 (true | false)
NEST_DEBUG_PERFORMANCE_MONITORING=true

# 是否启用错误诊断 (true | false)
NEST_DEBUG_ERROR_DIAGNOSIS=true

# =============================================================================
# 日志配置
# =============================================================================
# 日志级别 (error | warn | info | debug | verbose)
NEST_LOG_LEVEL=info

# 是否启用文件日志 (true | false)
NEST_LOG_FILE_ENABLED=false

# 日志文件目录
NEST_LOG_DIR=./logs
